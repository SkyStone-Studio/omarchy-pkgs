post_install() {
  cat <<'EOF'
omp (Oh My Pi) usage collector installed.

Refresh the record and the bar:
  omarchy agent usage-update --force omp
  omarchy restart shell
EOF
}

post_upgrade() {
  post_install
}

pre_remove() {
  cat <<'EOF'
User state is not removed:
  ~/.local/state/omarchy/agents/usage/omp.json
  ~/.cache/omarchy/agent-usage/
EOF
}
